SERVER_PORT=3000

PGDATABASE=
PGUSER=
PGPASSWORD=
PGPORT=5432
PGHOST=localhost

POLL_DATABASE_NAME=
POLL_DATABASE_USER=
POLL_DATABASE_PASSWORD=
POLL_DATABASE_PORT=5432
POLL_DATABASE_HOST=localhost

MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

MAIL_RECEIVERS= comma separated email list e.g mtaz@gmail.com,fgonz@neotree.org

# Optional: web editor that resolves CE digest entries to scripts/screens/fields.
# EDITOR_API_KEY is an API key issued by that editor (same mechanism the mobile app uses).
EDITOR_URL=
EDITOR_API_KEY=

# Optional: recipients of the daily CE digest (falls back to MAIL_RECEIVERS).
CE_DIGEST_RECEIVERS=

# Optional rate limits, per window (default 5 minutes). RATE_LIMIT_MAX: uploads per tablet (default 30000).
# RATE_LIMIT_READ_MAX: all other requests together (default 6000). 0 turns a limit off.
RATE_LIMIT_WINDOW_MINUTES=
RATE_LIMIT_MAX=
RATE_LIMIT_READ_MAX=
